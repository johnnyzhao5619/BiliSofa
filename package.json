{
  "name": "bilisofa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit && node tools/check-boundaries.mjs && node tools/check-docs.mjs --self-test && node tools/check-docs.mjs",
    "test": "node --import ./tools/register-ts.mjs --test tests/unit/*.test.ts tests/contracts/*.test.ts",
    "build": "node tools/build.mjs",
    "dev": "node tools/serve.mjs",
    "test:native:http": "python3 tests/native/http-probe.test.py",
    "test:native:media": "python3 tests/native/media-probe.test.py",
    "test:native:stop": "python3 tests/native/service-stop.test.py",
    "test:native:guest": "python3 tests/native/guest-probe.test.py",
    "test:native:bridge": "python3 tests/native/bridge-probe.test.py",
    "test:native:cast": "python3 tests/native/cast-probe.test.py",
    "test:native:session": "python3 tests/native/session-probe.test.py",
    "probe:deps:fetch": "python3 tools/build-network-candidate.py fetch",
    "probe:deps:build": "python3 tools/build-network-candidate.py build",
    "probe:deps:check": "python3 tools/build-network-candidate.py check",
    "probe:deps:link": "python3 tools/link-network-candidate.py",
    "test:ui:deps": "playwright test --config tests/config/playwright.network-candidate.config.ts",
    "test:native:cast-source": "python3 tests/native/cast-source-probe.test.py",
    "probe:network:ui": "node tools/build-network-probe.mjs",
    "package:network": "python3 tools/package-network-probe.py",
    "verify:network": "python3 tools/verify-network-probe.py",
    "test:ui:network": "playwright test --config tests/config/playwright.network-validation.config.ts",
    "probe:host:network": "python3 tools/build-host-network-fixture.py",
    "test:native:https-session": "python3 tests/native/https-session.test.py",
    "package:network:https-session": "python3 tools/package-network-probe.py --https-session",
    "package:network:account": "python3 tools/package-network-probe.py --account",
    "test:ui:account": "playwright test --config tests/config/playwright.account-validation.config.ts",
    "test:native:account": "python3 tests/native/account-probe.test.py",
    "test:native:progress": "python3 tests/native/progress-post.test.py",
    "package:network:account-reconcile": "python3 tools/package-network-probe.py --account-reconcile",
    "test:native:account-readback": "python3 tests/native/account-readback.test.py",
    "build:app": "node tools/build-foundation-app.mjs",
    "test:ui:app": "playwright test --config tests/config/playwright.app.config.ts",
    "native:identity": "python3 tools/link-identity.py",
    "package:app": "python3 tools/package-foundation-app.py",
    "test:package:app": "python3 tests/native/app-packaging.test.py",
    "sign:app": "python3 tools/sign-foundation-app.py",
    "deploy:app": "python3 tools/deploy-foundation-app.py",
    "test:native:identity": "python3 tests/native/identity.test.py",
    "test:native:catalog": "python3 tests/native/catalog-visitor.test.py",
    "test:native:search": "python3 tests/native/search.test.py",
    "test:native:hot-search": "python3 tests/native/hot-search.test.py",
    "test:native:library": "python3 tests/native/library.test.py",
    "native:vod-api": "python3 tools/link-vod-api-failover.py",
    "native:vod-bridge": "python3 tools/link-vod-bridge-failover.py",
    "test:native:vod-api": "python3 tests/native/vod-api.test.py",
    "test:native:vod-bridge": "python3 tests/native/vod-bridge.test.py",
    "native:pgc-read": "python3 tools/link-pgc-read-failover.py",
    "test:native:pgc-read": "python3 tests/native/pgc-read.test.py",
    "native:pgc-follow": "python3 tools/link-pgc-follow.py",
    "test:native:pgc-follow": "python3 tests/native/pgc-follow.test.py",
    "native:live-read": "python3 tools/link-live-read.py",
    "native:live-product": "python3 tools/link-live-product.py",
    "test:native:live-product": "python3 tests/native/live-product.test.py",
    "native:overlay-read": "python3 tools/link-overlay-read.py",
    "test:native:overlay-read": "python3 tests/native/overlay-read.test.py",
    "native:comments-read": "python3 tools/link-comments-read.py",
    "test:native:comments-read": "python3 tests/native/comments-read.test.py",
    "native:video-interactions": "python3 tools/link-video-interactions.py",
    "test:native:video-interactions": "python3 tests/native/video-interactions.test.py",
    "native:cast-product": "python3 tools/link-cast-product.py",
    "test:native:cast-product": "python3 tests/native/cast-product.test.py",
    "test:native:recommend": "python3 tests/native/recommend-read.test.py"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4"
  }
}
