# Loaded only on the production proxy, from its persistent read-only sites directory.
lunarca.app {
    header {
        -Server
        Strict-Transport-Security "max-age=31536000"
    }

    @bilisofa path /BiliSofa /BiliSofa/*
    handle @bilisofa {
        @bilisofa_root path /BiliSofa
        redir @bilisofa_root /BiliSofa/ 308

        @bilisofa_assets {
            method GET HEAD
            path /BiliSofa/ /BiliSofa/index.html /BiliSofa/portal/style.css /BiliSofa/portal/base.css /BiliSofa/portal/tokens.css /BiliSofa/design/evidence/2026-10-26-p2a-layout/7-search.png /BiliSofa/design/evidence/2026-10-26-p2a-layout/5-quick.png /BiliSofa/design/evidence/2026-10-26-p2a-layout/9-settings.png
        }
        handle @bilisofa_assets {
            header {
                X-Content-Type-Options nosniff
                Referrer-Policy no-referrer
                X-Frame-Options DENY
                Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
                Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; media-src 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'none'; base-uri 'none'; upgrade-insecure-requests"
                Cache-Control "public, max-age=0, must-revalidate"
            }
            reverse_proxy https://johnnyzhao5619.github.io {
                header_up Host lunarca.app
                header_up -Cookie
                header_up -Authorization
                header_up -Referer
                header_up -X-Forwarded-For
                header_up -X-Forwarded-Host
                header_up -X-Forwarded-Proto
                transport http {
                    tls_server_name johnnyzhao5619.github.io
                }
            }
        }
        handle {
            respond 404
        }
    }
    handle {
        reverse_proxy lunarca-website:8080
    }
}

www.lunarca.app {
    redir https://lunarca.app{uri} permanent
}
